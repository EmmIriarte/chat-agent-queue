# Application Settings
APP_NAME="Chat Agent Queue System"
APP_VERSION="1.0.0"
DEBUG=True
PORT=8000
LOG_LEVEL=INFO

# PostgreSQL (Internal Database) - Docker default values
POSTGRES_HOST=postgres  # Use 'localhost' for local development
POSTGRES_PORT=5432
POSTGRES_DB=chat_agent_queue
POSTGRES_USER=postgres
POSTGRES_PASSWORD=chatqueue2024  # Change in production!

# Supabase (External Database) - For account mappings and job info
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Unipile API
UNIPILE_API_DNS=api16.unipile.com:14690
UNIPILE_API_KEY=your_unipile_api_key

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Scheduling Policy Defaults (0 for instant testing)
DEFAULT_MIN_DELAY_MINUTES=0
DEFAULT_MAX_DELAY_MINUTES=0

# Retry Settings
MAX_RETRY_ATTEMPTS=3
